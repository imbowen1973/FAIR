<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:type="TaskPaneApp">
  <Id>9f3c1a52-6b7e-4d2a-9c48-0e5a1f70c3d8</Id>
  <Version>0.6.0</Version>
  <ProviderName>FAIR Consortium</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="eduFAIR Deck Assembler"/>
  <Description DefaultValue="Assemble a deck by competency from rendered session decks"/>
  <IconUrl DefaultValue="https://localhost:3000/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://github.com/imbowen1973/FAIR"/>
  <Hosts>
    <Host Name="Presentation"/>
  </Hosts>
  <!-- No <Requirements>: an unmet one makes Office refuse to start the
       add-in with "this add-in could not be started" and nothing else.
       taskpane.js checks PowerPointApi 1.2 with isSetSupported and says
       what is missing, which it can only do if it is allowed to run. -->
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
